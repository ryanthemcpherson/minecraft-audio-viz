{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-performance.schema.json",
  "title": "RuntimePerformanceMessage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "runtime_performance" },
    "v": { "const": "1.0.0" },
    "generation": { "type": "integer", "minimum": 1 },
    "level": {
      "type": "string",
      "enum": ["NORMAL", "PREVIEW_REDUCED", "FPS_REDUCED", "SAFE"]
    },
    "target_fps": { "type": "integer", "minimum": 1, "maximum": 240 },
    "entity_budget": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "particles_enabled": { "type": "boolean" }
  },
  "required": [
    "type",
    "generation",
    "level",
    "target_fps",
    "entity_budget",
    "particles_enabled"
  ]
}
