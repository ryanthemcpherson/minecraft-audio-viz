{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-ready.schema.json",
  "title": "RuntimeReadyMessage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "runtime_ready" },
    "v": { "const": "1.0.0" },
    "release_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
    },
    "runtime_api": { "type": "integer", "minimum": 1, "maximum": 1000000 },
    "generation": { "type": "integer", "minimum": 1 },
    "launch_nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "pid": { "type": "integer", "minimum": 1 },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9._-]+$"
      }
    }
  },
  "required": [
    "type",
    "release_version",
    "runtime_api",
    "generation",
    "launch_nonce",
    "pid",
    "capabilities"
  ]
}
