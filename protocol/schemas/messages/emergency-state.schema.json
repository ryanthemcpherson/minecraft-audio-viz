{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "emergency-state.schema.json",
  "title": "EmergencyStateMessage",
  "description": "Authoritative blackout and freeze state broadcast after an emergency command.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "emergency_state" },
    "v": { "type": "string" },
    "blackout": { "type": "boolean" },
    "freeze": { "type": "boolean" },
    "emergency_revision": { "type": "integer", "minimum": 0 },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["type", "blackout", "freeze", "emergency_revision"]
}
