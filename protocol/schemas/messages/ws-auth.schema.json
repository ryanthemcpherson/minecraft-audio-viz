{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ws-auth.schema.json",
  "title": "MinecraftWebSocketAuthMessage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": { "const": "auth" },
    "v": { "type": "string" },
    "token": { "type": "string", "minLength": 1, "maxLength": 1024 }
  },
  "required": ["type", "token"]
}
