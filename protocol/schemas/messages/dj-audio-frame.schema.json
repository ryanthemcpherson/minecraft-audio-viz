{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dj-audio-frame.schema.json",
  "title": "DjAudioFrameMessage",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "dj_audio_frame"
    },
    "v": {
      "type": "string"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "ts": {
      "type": "number"
    },
    "bands": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "peak": {
      "type": "number",
      "minimum": 0
    },
    "beat": {
      "type": "boolean"
    },
    "beat_i": {
      "type": "number",
      "minimum": 0
    },
    "bpm": {
      "type": "number",
      "minimum": 0
    },
    "tempo_conf": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "beat_phase": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "i_bass": {
      "type": "number",
      "minimum": 0
    },
    "i_kick": {
      "type": "boolean"
    },
    "timing": {
      "type": "object",
      "description": "Optional DJ-local monotonic durations in milliseconds. Buffer receipt is mono buffer ingress, enqueue is before bridge serialization; excludes device, network and Minecraft delivery. window_ms is sample-window duration, not measured processing latency.",
      "additionalProperties": false,
      "properties": {
        "buffer_to_analysis_ms": {"type": "number", "minimum": 0, "maximum": 60000},
        "analysis_ms": {"type": "number", "minimum": 0, "maximum": 60000},
        "analysis_to_enqueue_ms": {"type": "number", "minimum": 0, "maximum": 60000},
        "window_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 60000}
      },
      "required": ["buffer_to_analysis_ms", "analysis_ms", "analysis_to_enqueue_ms", "window_ms"]
    },
    "direct_mode": {
      "type": "boolean",
      "description": "Whether this DJ is using direct Minecraft connection mode"
    }
  },
  "required": ["type", "seq", "ts", "bands", "peak", "beat", "beat_i", "bpm"]
}
