{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcav.live/schemas/types/dj-invite.schema.json",
  "title": "DjInvite",
  "description": "A short-lived DJ connection invitation bound to the configured MCAV ingress and, for generated TLS, its leaf certificate.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "server_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^wss://[^/?#@]+/ws/dj$"
    },
    "connect_code": {
      "type": "string",
      "pattern": "^[A-Z]{4}-[A-HJ-KM-NP-Z2-9]{4}$"
    },
    "certificate_sha256": {
      "type": "string",
      "pattern": "^[0-9A-F]{64}$"
    },
    "expires_at": {
      "type": "integer",
      "minimum": 1,
      "description": "Unix expiration time. Producers limit invitations to at most 86400 seconds."
    }
  },
  "required": [
    "schema_version",
    "server_url",
    "connect_code",
    "expires_at"
  ]
}
