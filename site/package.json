{
  "name": "mcav-site",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "postcss": "8.5.26"
  },
  "scripts": {
    "generate-patterns": "node scripts/generate-patterns.mjs",
    "bundle-fengari": "node scripts/bundle-fengari.mjs",
    "prebuild": "node scripts/bundle-fengari.mjs && node scripts/generate-patterns.mjs",
    "dev": "node scripts/bundle-fengari.mjs && node scripts/generate-patterns.mjs && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "fengari": "^0.1.5",
    "next": "^16.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^4.1.11"
  }
}
