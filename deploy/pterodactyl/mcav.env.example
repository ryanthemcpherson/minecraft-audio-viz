# Optional overrides. Safe defaults require no mcav.env file.
# Copy this file to mcav.env only when the server allocations differ.

HTTP_PORT=8080
BROADCAST_PORT=8766
VJ_SERVER_PORT=9000
METRICS_PORT=9001
ENTITY_COUNT=160

# Used only in console endpoint messages; it does not change bind addresses.
# MCAV_PUBLIC_HOST=play.example.com
