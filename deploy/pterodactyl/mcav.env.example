# Copy this file to mcav.env, then set MCAV_PUBLIC_HOST before the first start.
# It must be a public IPv4 or IPv6 address, not a hostname or private IP.

# MCAV_PUBLIC_HOST=YOUR_PUBLIC_IP
HTTP_PORT=8080
VJ_SERVER_PORT=25808
UNIFIED_WEB=true

# Metrics remain loopback-only; do not create a public allocation for this port.
METRICS_PORT=9001
ENTITY_COUNT=160

# Legacy split-browser recovery only; unused while UNIFIED_WEB=true.
# BROADCAST_PORT=8766
